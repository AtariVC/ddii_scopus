       <property name="placeholderText"><string>Номер</string></property>
      </widget>
     </item>
     <item>
      <widget class="PrimaryButton" name="pushButton_save_frame">
       <property name="minimumSize"><size><width>110</width><height>40</height></size></property>
       <property name="text"><string>Сохранить</string></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
